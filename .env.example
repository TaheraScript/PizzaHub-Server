# pizzahub-server environment variables
# Copy to `.env` and fill in real values. Never commit real secrets.

PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=pizzahub

# Auth (must match the client)
BETTER_AUTH_SECRET=
JWT_SECRET=

# CORS — the client origin(s); comma-separated for multiple
CLIENT_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (vendor subscription only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# ImgBB
IMGBB_API_KEY=
